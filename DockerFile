# syntax=docker/dockerfile:1

# ============================================================
# Stage 1: BUILD  - full JDK + Maven, compiles and packages the jar
# ============================================================
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app

# Copy only pom.xml first so the dependency download is cached
# and re-runs only when pom.xml changes.
COPY pom.xml .
RUN mvn -B -q dependency:go-offline

# Now copy the source and build the jar (tests are skipped for the image build).
COPY src ./src
RUN mvn -B -q clean package -DskipTests

# ============================================================
# Stage 2: RUNTIME - small JRE-only image, just the jar
# ============================================================
FROM eclipse-temurin:17-jre
WORKDIR /app

# Run as a non-root user, and create the folder where resumes are saved
RUN groupadd -r spring && useradd -r -g spring spring \
    && mkdir -p /app/uploads/resumes \
    && chown -R spring:spring /app

# pom.xml sets <finalName>ats</finalName>, so the jar is target/ats.jar
COPY --from=build /app/target/ats.jar app.jar

USER spring
EXPOSE 8080

# Use up to 75% of the container's memory for the JVM heap
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75"

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]